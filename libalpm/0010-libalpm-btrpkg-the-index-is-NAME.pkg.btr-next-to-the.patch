From 6cbc9f176b4187370ef3da620c5412c1d98f54ac Mon Sep 17 00:00:00 2001
From: Jonny Heggheim <hegjon@gmail.com>
Date: Sun, 22 Nov 2026 13:14:17 +0200
Subject: [PATCH 10/10] libalpm: btrpkg: the index is NAME.pkg.btr next to the
 package file

btrpkg.index is now NAME.pkg.btr: repositories keep the index beside
NAME.pkg.tar.zst as a .pkg.btr without its data (the same bytes the
cache file starts with, and the same signature), instead of
index/NAME.btridx. The cache file takes the same name. An entry in the
old form is unusable data: the package file is downloaded instead.
---
 lib/libalpm/sync.c | 24 +++++++++++-------------
 1 file changed, 11 insertions(+), 13 deletions(-)

diff --git a/lib/libalpm/sync.c b/lib/libalpm/sync.c
index 997f1db0..d3dae25f 100644
--- a/lib/libalpm/sync.c
+++ b/lib/libalpm/sync.c
@@ -94,9 +94,6 @@ static int btr_unhex32(const char *s, unsigned char out[32])
 	return 0;
 }
 
-/* Sync targets whose database entry carries btrpkg data come as NAME.pkg.btr cache files,
- * when a helper is configured and the cache directory is on btrfs (their data is shared with
- * the installed files by reflink). Everything else is downloaded as usual. */
 /* Where a package's repository keeps its btrparts, relative to the repository's URL: the
  * database's btrpkg.parts (e.g. ../btrparts, shared by the architecture directories), else
  * btrparts inside it. */
@@ -121,6 +118,11 @@ static int btr_parts_ok(const char *p)
 	return 1;
 }
 
+/* Sync targets whose database entry carries btrpkg data come as NAME.pkg.btr cache files,
+ * when a helper is configured and the cache directory is on btrfs (their data is shared with
+ * the installed files by reflink). Everything else is downloaded as usual.
+ * btrpkg.index is NAME.pkg.btr: the repository keeps the index next to the package file, as a
+ * .pkg.btr without its data, and the cache file has the same name (and the same signature). */
 static void btr_select(alpm_handle_t *handle, const char *cachedir)
 {
 	struct statfs sf;
@@ -139,13 +141,12 @@ static void btr_select(alpm_handle_t *handle, const char *cachedir)
 		}
 		index = btr_xdata(spkg, "btrpkg.index");
 		id = btr_xdata(spkg, "btrpkg.id");
-		if(!index || !id || strncmp(index, "index/", 6) != 0) {
+		if(!index || !id) {
 			continue;
 		}
-		const char *name = index + 6;
-		size_t len = strlen(name);
-		if(len <= 7 || strcmp(name + len - 7, ".btridx") != 0 || name[0] == '.'
-				|| memchr(name, '/', len - 7) || btr_unhex32(id, spkg->btr_id) != 0
+		size_t len = strlen(index);
+		if(len <= 8 || strcmp(index + len - 8, ".pkg.btr") != 0 || index[0] == '.'
+				|| strchr(index, '/') || btr_unhex32(id, spkg->btr_id) != 0
 				|| !btr_parts_ok(btr_parts(spkg))) {
 			_alpm_log(handle, ALPM_LOG_WARNING, _("%s: unusable btrpkg data in the database\n"), spkg->name);
 			continue;
@@ -159,12 +160,10 @@ static void btr_select(alpm_handle_t *handle, const char *cachedir)
 			free(have);
 			continue;
 		}
-		char *fn = malloc(len - 7 + 9);
+		char *fn = strdup(index);
 		if(!fn) {
 			continue;
 		}
-		memcpy(fn, name, len - 7);
-		strcpy(fn + len - 7, ".pkg.btr");
 		FREE(spkg->btr_plain);
 		spkg->btr_plain = spkg->filename;
 		spkg->filename = fn;
@@ -195,8 +194,7 @@ static int btr_have_index(const char *dir, alpm_pkg_t *p)
 {
 	char path[PATH_MAX];
 	struct stat st;
-	size_t fl = strlen(p->filename) - 8; /* without .pkg.btr */
-	if(snprintf(path, sizeof(path), "%s/index/%.*s.btridx", dir, (int)fl, p->filename) >= (int)sizeof(path)) {
+	if(snprintf(path, sizeof(path), "%s/%s", dir, p->filename) >= (int)sizeof(path)) {
 		return 0;
 	}
 	return lstat(path, &st) == 0 && S_ISREG(st.st_mode);
-- 
