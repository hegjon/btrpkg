+		if(btr) {
+			memset(siglist, 0, sizeof(*siglist));
+			RET_ERR(pkg->handle, ALPM_ERR_SIG_MISSING, -1);
+		}
+	}
+#endif
 
 	return _alpm_gpgme_checksig(pkg->handle, pkg->filename,
 			pkg->base64_sig, siglist);
