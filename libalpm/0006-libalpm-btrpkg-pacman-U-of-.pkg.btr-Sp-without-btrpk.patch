index 54c66d58..9bd9ffcd 100644
--- a/lib/libalpm/btrstream.h
+++ b/lib/libalpm/btrstream.h
@@ -29,6 +29,19 @@ int _alpm_btr_is_cache_file(int fd);
  * BTR_ERRLEN bytes. */
 int _alpm_btr_validate(int fd, const unsigned char *expected_id, uint64_t file_size, char *err);
 
+/* For a cache file that didn't come from pull-ids (pacman -U): every chunk's unencoded data,
+ * read back through the file, must have the index's hash. pull-ids checks each chunk as it
+ * assembles a cache file; nothing else does. */
+int _alpm_btr_check_data(int fd, uint64_t file_size, char *err);
+
+/* The btrpkg key directories, as btrpkg itself searches them. */
+extern const char *const _alpm_btr_keydirs[];
+
+/* The signify signature of the cache file at path (path.sig) over its header, by a key in
+ * _alpm_btr_keydirs. 0: signed, keypath (PATH_MAX) names the key; 1: no signature file;
+ * -1: a bad signature or a read error, err says which. */
+int _alpm_btr_check_sig(int fd, const char *path, char *keypath, char *err);
+
 /* Open archive `a` (formats already enabled) on the cache file fd as a tar stream. fd stays
  * owned by the caller and must outlive the archive. */
 int _alpm_btr_archive_open(struct archive *a, int fd, uint64_t file_size, char *err);
diff --git a/lib/libalpm/package.c b/lib/libalpm/package.c
index a7bccde3..cef2d651 100644
--- a/lib/libalpm/package.c
+++ b/lib/libalpm/package.c
@@ -711,6 +711,36 @@ void _alpm_pkg_xdata_free(alpm_pkg_xdata_t *pd)
 	}
 }
 
+#define BTR_VALIDATION_XDATA "btrpkg-validation"
+
+int _alpm_pkg_set_btr_signer(alpm_pkg_t *pkg, const char *keypath)
+{
+	alpm_list_t *i = pkg->xdata;
+	while(i) {
+		alpm_list_t *next = i->next;
+		alpm_pkg_xdata_t *pd = i->data;
+		if(strcmp(pd->name, BTR_VALIDATION_XDATA) == 0) {
+			pkg->xdata = alpm_list_remove_item(pkg->xdata, i);
+			_alpm_pkg_xdata_free(pd);
+			free(i);
+		}
+		i = next;
+	}
+	if(keypath) {
+		const char *base = strrchr(keypath, '/');
+		size_t len;
+		alpm_pkg_xdata_t *pd;
+		base = base ? base + 1 : keypath;
+		len = strlen("signify:") + strlen(base) + 1;
+		CALLOC(pd, 1, sizeof(alpm_pkg_xdata_t), return -1);
+		STRDUP(pd->name, BTR_VALIDATION_XDATA, free(pd); return -1);
+		MALLOC(pd->value, len, _alpm_pkg_xdata_free(pd); return -1);
+		snprintf(pd->value, len, "signify:%s", base);
+		pkg->xdata = alpm_list_add(pkg->xdata, pd);
+	}
+	return 0;
+}
+
 void _alpm_pkg_free(alpm_pkg_t *pkg)
 {
 	if(pkg == NULL) {
@@ -718,6 +748,7 @@ void _alpm_pkg_free(alpm_pkg_t *pkg)
 	}
 
 	FREE(pkg->filename);
+	FREE(pkg->btr_signer);
 	FREE(pkg->base);
 	FREE(pkg->name);
 	FREE(pkg->version);
