# Maintainer: Jonny Heggheim <hegjon@gmail.com>
#
# pacman with the btrpkg patches, installed beside the system pacman: Arch's pacman package (same
# commit, same patches, same build options) plus libalpm/00*.patch of the btrpkg repository
# (the same commits as branch btrpkg of https://github.com/hegjon/pacman).
#   /usr/bin/pacman-btrpkg           -> /usr/lib/pacman-btrpkg/pacman (RUNPATH to its own libalpm)
#   /usr/bin/pacman-btrpkg-conf      pacman-conf of this build
#   /etc/pacman-btrpkg.conf          default config: BtrPkgHelper + Include = /etc/pacman.conf
#   /usr/bin/pacstrap-btrpkg         Arch's pacstrap with pacman-btrpkg (needs arch-install-scripts)
#   /usr/bin/makebtrpkg              makepkg of this build: also converts the packages to btrpkg
#                                    (uses the system's libmakepkg, same pacman version)
# It shares the database, lock, cache, hooks and keyring with the system pacman, which stays
# untouched and can be used at any time.
pkgname=pacman-btrpkg
_commit=54d94116164b0b2202c6061c4a59c6f3e70820d8
_archpkg=7.1.0.r9.g54d9411-4    # Arch's packaging tag the patches below come from
pkgver=7.1.0.r9.g54d9411
pkgrel=13
pkgdesc="pacman that installs btrpkg packages (reflinked, encoded btrfs writes), beside the system pacman"
arch=(x86_64 aarch64)
url="https://github.com/hegjon/btrpkg"
license=(GPL-2.0-or-later)
depends=(pacman btrpkg
         bash curl libcurl.so glibc gpgme libgpgme.so libarchive libarchive.so
         openssl libcrypto.so zstd libzstd.so)
optdepends=('arch-install-scripts: pacstrap-btrpkg')
makedepends=(git meson)
checkdepends=(fakechroot python)
backup=(etc/pacman-btrpkg.conf)
_arch=https://gitlab.archlinux.org/archlinux/packaging/packages/pacman/-/raw/$_archpkg
source=("pacman::git+https://gitlab.archlinux.org/pacman/pacman.git#commit=$_commit"
