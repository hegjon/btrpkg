prepare() {
  cd pacman
  # Arch's patches, as in Arch's PKGBUILD
  patch -RNp1 < ../revertme-makepkg-remove-libdepends-and-libprovides.patch
  patch -Np1 < ../patch-reproducible-builds.patch
  patch -Np1 < ../arch-0001-libalpm-invalidate-curl-data-in-child.patch
  patch -Np1 < ../arch-0002-libalpm-use-curl-s-effective-url-without-authenticat.patch
  # btrpkg's (git apply: they carry binary test fixtures)
  git apply --whitespace=nowarn ../btrpkg-000*.patch
  # its own default config file, so it never reads a BtrPkgHelper line the system pacman warns about
  sed -i "s|conf.set_quoted('CONFFILE', join_paths(SYSCONFDIR, 'pacman.conf'))|conf.set_quoted('CONFFILE', join_paths(SYSCONFDIR, 'pacman-btrpkg.conf'))|" meson.build
  grep -q "pacman-btrpkg.conf" meson.build
}

build() {
  cd pacman
  # find our libalpm, not the system's (same soname)
  export LDFLAGS+=" -Wl,-rpath,/usr/lib/$pkgname"
  meson setup --prefix=/usr \
        --buildtype=plain \
        -Ddoc=disabled \
        -Ddoxygen=disabled \
        -Dscriptlet-shell=/usr/bin/bash \
        -Dldconfig=/usr/bin/ldconfig \
        build
  grep -q '#define HAVE_BTRPKG' build/config.h
  meson compile -C build
}

check() {
  cd pacman
  meson test -C build
}

package() {
  cd pacman
  local stage="$srcdir/stage"
  rm -rf "$stage"
  DESTDIR="$stage" meson install -C build
  install -Dm755 "$stage/usr/bin/pacman" "$pkgdir/usr/lib/$pkgname/pacman"
  install -Dm755 "$stage/usr/bin/pacman-conf" "$pkgdir/usr/lib/$pkgname/pacman-conf"
  cp -a "$stage"/usr/lib/libalpm.so.* "$pkgdir/usr/lib/$pkgname/"
  install -dm755 "$pkgdir/usr/bin"
  ln -s ../lib/$pkgname/pacman "$pkgdir/usr/bin/pacman-btrpkg"
  ln -s ../lib/$pkgname/pacman-conf "$pkgdir/usr/bin/pacman-btrpkg-conf"
  install -Dm644 "$srcdir/pacman-btrpkg.conf" "$pkgdir/etc/pacman-btrpkg.conf"
  install -Dm755 "$srcdir/pacstrap-btrpkg" "$pkgdir/usr/bin/pacstrap-btrpkg"
}
