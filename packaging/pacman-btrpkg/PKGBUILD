# Maintainer: Jonny Heggheim <hegjon@gmail.com>
#
# pacman with the btrpkg patches, installed beside the system pacman: Arch's pacman package (same
# commit, same patches, same build options) plus libalpm/000*.patch of the btrpkg repository.
#   /usr/bin/pacman-btrpkg           -> /usr/lib/pacman-btrpkg/pacman (RUNPATH to its own libalpm)
#   /usr/bin/pacman-btrpkg-conf      pacman-conf of this build
#   /etc/pacman-btrpkg.conf          default config: BtrPkgHelper + Include = /etc/pacman.conf
#   /usr/bin/pacstrap-btrpkg         Arch's pacstrap with pacman-btrpkg (needs arch-install-scripts)
# It shares the database, lock, cache, hooks and keyring with the system pacman, which stays
# untouched and can be used at any time.
pkgname=pacman-btrpkg
_commit=54d94116164b0b2202c6061c4a59c6f3e70820d8
_archpkg=7.1.0.r9.g54d9411-4    # Arch's packaging tag the patches below come from
pkgver=7.1.0.r9.g54d9411
pkgrel=7
pkgdesc="pacman that installs btrpkg packages (reflinked, encoded btrfs writes), beside the system pacman"
arch=(x86_64 aarch64)
url="https://github.com/hegjon/btrpkg"
license=(GPL-2.0-or-later)
depends=(pacman btrpkg
         bash curl libcurl.so glibc gpgme libgpgme.so libarchive libarchive.so
         openssl libcrypto.so zstd libzstd.so)
optdepends=('arch-install-scripts: pacstrap-btrpkg')
makedepends=(git meson)
checkdepends=(fakechroot python)
backup=(etc/pacman-btrpkg.conf)
_arch=https://gitlab.archlinux.org/archlinux/packaging/packages/pacman/-/raw/$_archpkg
source=("pacman::git+https://gitlab.archlinux.org/pacman/pacman.git#commit=$_commit"
        "revertme-makepkg-remove-libdepends-and-libprovides.patch::https://gitlab.archlinux.org/pacman/pacman/-/commit/354a300cd26bb1c7e6551473596be5ecced921de.patch"
        "patch-reproducible-builds.patch::https://gitlab.archlinux.org/pacman/pacman/-/commit/f4bdb77470528019aaba4d8b8f947e918c6db17d.patch"
        "arch-0001-libalpm-invalidate-curl-data-in-child.patch::$_arch/0001-libalpm-invalidate-curl-data-in-child.patch"
        "arch-0002-libalpm-use-curl-s-effective-url-without-authenticat.patch::$_arch/0002-libalpm-use-curl-s-effective-url-without-authenticat.patch"
        btrpkg-0001-libalpm-read-btrpkg-indexes-and-their-signatures.patch
        btrpkg-0002-libalpm-install-btrpkg-packages-from-sync-repositori.patch
        btrpkg-0003-libalpm-btrpkg-downloads-in-pacman-s-sandbox-with-re.patch
        btrpkg-0004-libalpm-btrpkg-use-a-package-file-that-is-already-in.patch
        btrpkg-0005-libalpm-btrpkg-one-root-process-when-downloads-aren-.patch
        btrpkg-0006-libalpm-btrpkg-pacman-U-of-.pkg.btr-Sp-without-btrpk.patch
        btrpkg-0007-libalpm-btrpkg-btrparts-where-the-database-says-btrp.patch
        btrpkg-0008-libalpm-btrpkg-fall-back-to-the-package-file.patch
        btrpkg-0009-libalpm-btrpkg-plan-each-package-once.patch
        pacman-btrpkg.conf
        pacstrap-btrpkg)
